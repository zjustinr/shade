# Copy to .env.local and fill in. Every service here has a free tier —
# the project must run at $0 (SPEC §10 Cost).

# Vercel Postgres (Neon). Also used by drizzle-kit for migrations.
POSTGRES_URL=

# Vercel Blob — reading photos.
BLOB_READ_WRITE_TOKEN=

# Shared field-tool passcode (crew of six).
CREW_PASSCODE=

# Lead-only admin passcode. Must differ from CREW_PASSCODE.
ADMIN_PASSCODE=

# MapLibre style JSON. Must be keyless and free — Protomaps or OpenFreeMap.
# Do NOT point this at Mapbox or Google; both require billing (SPEC §3).
NEXT_PUBLIC_BASEMAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# Deep-link target for indoor cooling resources. This app never rehosts or
# scrapes the City's data — it links out (SPEC §0, §5).
NEXT_PUBLIC_CITY_COOLING_MAP_URL=https://experience.arcgis.com/experience/d947122ea5e54cea8d0ece21cecb4e99
